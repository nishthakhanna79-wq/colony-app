# Paste this into the app's Secrets box on Streamlit Community Cloud, with your real values.
# Never commit real values. A real secrets.toml file is listed in .gitignore.
# Do not add an [auth] section: Streamlit would count this app as your one private app.

[login]
# The one password everyone in the lab uses. At least 16 characters. 4 random words works well.
password = "FOUR-RANDOM-WORDS-LIKE-THIS"

[github]
# The private repo that holds the records, not this public one.
repo = "YOUR-GITHUB-NAME/YOUR-PRIVATE-DATA-REPO"
token = "FINE-GRAINED-TOKEN-FOR-THE-DATA-REPO-ONLY"
branch = "data"
